{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "gcc",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
        },
        {
            "name": "clang",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
        },
        { "name": "gcc-debug", "inherits": "gcc", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "gcc-release", "inherits": "gcc", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
        { "name": "gcc-asan", "inherits": "gcc", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OB_SANITIZE": "asan" } },
        { "name": "gcc-ubsan", "inherits": "gcc", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OB_SANITIZE": "ubsan" } },
        { "name": "gcc-tsan", "inherits": "gcc", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OB_SANITIZE": "tsan" } },
        { "name": "clang-debug", "inherits": "clang", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "clang-release", "inherits": "clang", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
        { "name": "clang-asan", "inherits": "clang", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OB_SANITIZE": "asan" } },
        { "name": "clang-ubsan", "inherits": "clang", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OB_SANITIZE": "ubsan" } },
        { "name": "clang-tsan", "inherits": "clang", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OB_SANITIZE": "tsan" } }
    ],
    "buildPresets": [
        { "name": "gcc-debug", "configurePreset": "gcc-debug" },
        { "name": "gcc-release", "configurePreset": "gcc-release" },
        { "name": "gcc-asan", "configurePreset": "gcc-asan" },
        { "name": "gcc-ubsan", "configurePreset": "gcc-ubsan" },
        { "name": "gcc-tsan", "configurePreset": "gcc-tsan" },
        { "name": "clang-debug", "configurePreset": "clang-debug" },
        { "name": "clang-release", "configurePreset": "clang-release" },
        { "name": "clang-asan", "configurePreset": "clang-asan" },
        { "name": "clang-ubsan", "configurePreset": "clang-ubsan" },
        { "name": "clang-tsan", "configurePreset": "clang-tsan" }
    ],
    "testPresets": [
        { "name": "gcc-debug", "configurePreset": "gcc-debug", "output": { "outputOnFailure": true } },
        { "name": "gcc-release", "configurePreset": "gcc-release", "output": { "outputOnFailure": true } },
        { "name": "gcc-asan", "configurePreset": "gcc-asan", "output": { "outputOnFailure": true } },
        { "name": "gcc-ubsan", "configurePreset": "gcc-ubsan", "output": { "outputOnFailure": true } },
        { "name": "gcc-tsan", "configurePreset": "gcc-tsan", "output": { "outputOnFailure": true } },
        { "name": "clang-debug", "configurePreset": "clang-debug", "output": { "outputOnFailure": true } },
        { "name": "clang-release", "configurePreset": "clang-release", "output": { "outputOnFailure": true } },
        { "name": "clang-asan", "configurePreset": "clang-asan", "output": { "outputOnFailure": true } },
        { "name": "clang-ubsan", "configurePreset": "clang-ubsan", "output": { "outputOnFailure": true } },
        { "name": "clang-tsan", "configurePreset": "clang-tsan", "output": { "outputOnFailure": true } }
    ]
}
